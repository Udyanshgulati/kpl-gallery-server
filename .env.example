# KPL Gallery Server — environment
# Copy to .env for local dev; in production set these in Coolify.

# Shared secret for POST /api/gallery/upload and DELETE /api/gallery/:id
GALLERY_UPLOAD_KEY=change-me

# Public origin the returned image URLs are built from
GALLERY_PUBLIC_BASE=https://media.korfballpremierleague.com

# Port the Node process listens on
PORT=4000

# KPL-ONLY directory on the host. Must NOT be inside any Thoda Logic
# media path and must have no shared parent with one.
MEDIA_ROOT=/var/www/kpl-media
